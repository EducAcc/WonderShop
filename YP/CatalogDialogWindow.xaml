<Window x:Class="WonderShoe.CatalogDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WonderShoe"
        mc:Ignorable="d"
        Title="Каталог товаров" Height="500" MinHeight="500" Width="800" MinWidth="900">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <local:CatalogControl x:Name="CatalogControl" Grid.Row="0"/>

        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0 10 0 0">
            <Button Content="Назад" IsCancel="True" DockPanel.Dock="Left"/>
            <Button Content="Добавить товары в заказ" IsDefault="True" DockPanel.Dock="Right" Click="AddProductsInOrder_Click"/>
        </DockPanel>
    </Grid>
</Window>
