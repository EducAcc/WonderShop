<Window x:Class="WonderShoe.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WonderShoe"
        mc:Ignorable="d"
        Title="Авторизация" Height="300" Width="300" ResizeMode="NoResize" SizeToContent="Height">
    <StackPanel Margin="20">
        <Label Content="Авторизация" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold" Margin="0 0 0 20"/>

        <Label Content="Логин"/>
        <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

        <Button Content="Подтвердить" Click="ApplyBtn_Click" IsDefault="True" Margin="20 40 20 20"/>
    </StackPanel>
</Window>

