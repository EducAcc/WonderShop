<Window x:Class="WonderShoe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WonderShoe"
        xmlns:services="clr-namespace:WonderShoe.Services"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Главная" Height="500" MinHeight="500" Width="800" MinWidth="900" Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!--Верхняя панель с логином-->
        <StackPanel Grid.Row="0" Margin="0 0 0 5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding User.SNP}" Foreground="#70B2AF" Margin="0 0 20 0" VerticalAlignment="Center"/>
            <Button Content="Войти" Click="LoginBtn_Click"/>
        </StackPanel>

        <!--Основная панель, зависит от роли-->
        <TabControl Grid.Row="1">
            <TabItem Header="Каталог" Visibility="{Binding IsUserAdminOrManager, Converter={StaticResource BoolToVis}}">
                <!--Каталог товаров вызывается через юзер контрол
                Сделал так, для избежания дублирования кода, потому что этот же каталог будет использоваться в заказах-->
                <local:CatalogControl x:Name="CatalogControl"/>
            </TabItem>
            <TabItem Header="Заказы" Visibility="{Binding IsUserAdminOrManager, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 10">
                        <Button Content="Добавить" Click="AddOrderBtn_Click"/>
                        <Button Content="Удалить" Click="DeleteOrderBtn_Click" Margin="20 0 0 0"/>
                    </StackPanel>
                    
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" MouseDoubleClick="OrdersTable_MouseDoubleClick" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date}"/>
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding User.SNP}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>


    </Grid>
</Window>