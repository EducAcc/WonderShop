<Window x:Class="WonderShoe.OrderInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WonderShoe"
        mc:Ignorable="d"
        Title="Информация о заказе" Height="450" MinHeight="450" Width="820" MinWidth="820" SizeToContent="Height">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Margin="20" HorizontalAlignment="Left" Grid.Row="0">
            <DockPanel LastChildFill="False">
                <DatePicker SelectedDate="{Binding OrderDate}" DisplayDateStart="{Binding StartDate, Mode=OneWay}" DisplayDateEnd="{Binding EndDate, Mode=OneWay}" IsEnabled="{Binding IsEditibleMode}" DockPanel.Dock="Left" Width="150" HorizontalAlignment="Left"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsEditibleMode, Converter={StaticResource BoolToVis}}">
                    <Button Content="Добавить товар" Click="AddProductBtn_Click"/>
                    <Button Content="Удалить товар" Click="DeleteProductBtn_Click" Margin="20 0 0 0"/>
                </StackPanel>
            </DockPanel>
            
            <DataGrid Margin="0 15 0 0" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Наименование" Binding="{Binding Product.Name}"/>
                    <DataGridTextColumn Header="Производитель" Binding="{Binding Product.Manufacturer.Name}"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding Product.Subcategory.Category.Name}"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Total}"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <Button Content="Сохранить" Click="SaveBtn_Click" Margin="20" VerticalAlignment="Bottom" Grid.Row="1"/>

    </Grid>
</Window>
